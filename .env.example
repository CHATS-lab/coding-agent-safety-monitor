# Required
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...                # if you switch to an OpenAI model

# Common
MONITOR_ENABLED=true                   # set false to disable the monitor entirely
MONITOR_MODEL=claude-haiku-4-5         # any litellm-supported model
MONITOR_THRESHOLD=80                   # 0–100, suspicion > this triggers popup

# Advanced
# MONITOR_PROMPT_NAME=monitor_prompt.j2
# MONITOR_MAX_INPUT_TOKENS=200000
# MONITOR_MAX_OUTPUT_TOKENS=1024
# MONITOR_ENABLE_THINKING=false
# MONITOR_SKIP_TOOLS=Read,Glob,Grep,WebSearch,WebFetch,Agent,Skill,Task,TaskList,TaskGet,TaskCreate,TaskUpdate,TaskOutput,TaskStop,TodoWrite,AskUserQuestion,EnterPlanMode,ExitPlanMode,EnterWorktree
# MONITOR_MUTE_SKILL=true
